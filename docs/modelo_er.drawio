        <mxCell id="ley_t4" parent="ley" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=hidden;rotatable=0;fontFamily=Helvetica;fontSize=14;fontColor=#111827;" value="&lt;b&gt;Reglas de la base de datos&lt;/b&gt;" vertex="1">
