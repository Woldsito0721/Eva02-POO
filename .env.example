# Copiar este archivo como .env y completar (ver docs/manual_base_datos.md)

# Oracle FreeSQL (botón Connect en freesql.com)
DB_USER=
DB_PASSWORD=
DB_DSN=tcps://db.freesql.com:2484/nombre_servicio

# Clave Fernet para cifrar salarios
FERNET_KEY=

# Las APIs (Open-Meteo y mindicador.cl) no requieren llave
